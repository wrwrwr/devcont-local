{
  "name": "devcont-local",
  "displayName": "Dev Containers: Local Add-on",
  "version": "0.0.1",
  "description": "Merge local configuration with devcontainer.json.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "vscode",
    "extension",
    "devcontainers"
  ],
  "bugs": {
    "url": "https://github.com/wrwrwr/devcont-local/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrwrwr/devcont-local.git"
  },
  "license": "MIT",
  "author": "wrwrwr",
  "publisher": "wrwrwr",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/extension.ts"
  },
  "main": "./src/extension.ts",
  "files": [
    "assets/icon-opt.png",
    "node_modules/ini",
    "node_modules/jsonc-parser/lib/umd",
    "node_modules/jsonc-parser/*",
    "src/**/*.ts",
    "license.txt",
    "readme.md"
  ],
  "contributes": {
    "configuration": {
      "title": "Dev Containers: Local Add-on",
      "type": "object",
      "properties": {
        "devcontLocal.mergeOnChanges": {
          "title": "Merge on Changes",
          "type": "boolean",
          "default": true,
          "markdownDescription": "When you save `devcontainer[-local].json` or change `commonConfiguration`.",
          "scope": "resource"
        },
        "devcontLocal.commonConfiguration": {
          "title": "Common Configuration",
          "type": "object",
          "markdownDescription": "Properties to merge into every `devcontainer.json`.",
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "title": "Dev Containers: Local Add-on: Merge Configurations",
        "command": "devcontLocal.mergeConfigs"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:.devcontainer.json",
    "workspaceContains:.devcontainer-local.json",
    "workspaceContains:.devcontainer/devcontainer.json",
    "workspaceContains:.devcontainer/devcontainer-local.json"
  ],
  "dependencies": {
    "ini": "^7.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ini": "^4.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-package-json": "^1.11.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "icon": "assets/icon-opt.png",
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
